---
import SpeciesDirectory from "@/components/SpeciesDirectory.svelte";
import Base from "@/layouts/Base.astro";
import { dayOfYear, PHASE_LABEL, PREPARED, speciesState } from "@/lib/model";

const today = dayOfYear();
const rows = PREPARED.map((s) => ({
	id: s.id,
	name: s.name,
	sci: s.sci,
	family: s.family ?? "",
	color: s.color,
	status: PHASE_LABEL[speciesState(s, today).phase],
	estimated: s.source === "estimated",
}));
---

<Base title="Species" description="Every tracked migratory species and where it is right now.">
	<h1>Species</h1>
	<SpeciesDirectory client:load rows={rows} />
</Base>
