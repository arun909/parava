---
import MigrationCalendar, {
	type YearSpecies,
} from "@/components/MigrationCalendar.svelte";
import type { CalEvent } from "@/components/UpcomingCalendar.svelte";
import Base from "@/layouts/Base.astro";
import { dayOfYear, MONTHS, MSTART, PREPARED, popState } from "@/lib/model";

// per species and month: is any population heading north, south, or both? Fixed by the model, so it is worked out here;
// only "today" is left to the browser
const species: YearSpecies[] = PREPARED.map((s) => ({
	id: s.id,
	name: s.name,
	color: s.color,
	hand: s.source !== "estimated",
	kind: s.kind,
	legs: MONTHS.map((_, m) => {
		const end = MSTART[m + 1] ?? 366;
		let n = false;
		let so = false;
		// every third day, so a short trip between two samples is not missed
		for (let d = MSTART[m]! + 1; d < end + 1; d += 3)
			for (const p of s.pops) {
				const ph = popState(p, d).phase;
				if (ph === "spring") n = true;
				if (ph === "autumn") so = true;
			}
		return n && so ? "b" : n ? "n" : so ? "s" : "-";
	}).join(""),
}));
const events: CalEvent[] = PREPARED.flatMap((s, si) =>
	s.pops.flatMap((p) =>
		p.dep.map((day, k): CalEvent => [si, Math.round(day), k, p.name]),
	),
);
---

<Base menu bare title="Calendar" description="When each migratory bird arrives, leaves and is in the air, month by month.">
	<h1 class="sr">Migration calendar</h1>
	<MigrationCalendar client:load {species} {events} built={Math.floor(dayOfYear())} />
</Base>

<style>
	.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
