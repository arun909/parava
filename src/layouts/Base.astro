---
import "@/styles/global.css";

interface Props {
	title: string;
	description?: string;
	bare?: boolean;
	/** Open connections to the data hosts early (globe page). */
	preconnect?: boolean;
	/** Use the full window width instead of the reading column. */
	wide?: boolean;
	/** Fold the links into a menu at the left, leaving the header's middle to the page (the map's controls). */
	menu?: boolean;
}
const {
	title,
	description = "Where the world's migratory birds are, today.",
	bare,
	preconnect,
	wide,
	menu,
} = Astro.props;
const hosts = [
	"https://tiles.openfreemap.org",
	"https://s3.amazonaws.com",
	"https://api.inaturalist.org",
	"https://api.gbif.org",
];
const nav = [
	["/map/", "Map"],
	["/calendar/", "Calendar"],
	["/about/", "About"],
];
const sources = [
	["https://www.inaturalist.org/", "iNaturalist"],
	["https://www.gbif.org/", "GBIF"],
	["https://ebird.org/", "eBird"],
	["https://openfreemap.org/", "OpenFreeMap"],
];
const path = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{preconnect && hosts.map((h) => <link rel="preconnect" href={h} crossorigin />)}
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{title} · Parava</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#fbfaf4" />
		<style>
			/* the globe stage sits at top: 60px, so the header keeps that height */
			header { position: sticky; top: 0; z-index: 20; height: 60px; display: flex; align-items: center; justify-content: center; padding: 0 var(--s4); pointer-events: none; }
			/* the emblem and the links share one floating pill */
			.bar { display: flex; align-items: center; gap: var(--s2); padding: 4px 6px 4px 4px; border: 1px solid var(--line); border-radius: 999px; background: color-mix(in srgb, var(--surface) 85%, transparent); backdrop-filter: blur(10px); box-shadow: var(--shadow); pointer-events: auto; }
			.bar .brand { display: block; border-radius: 50%; }
			.bar .brand img { display: block; width: 40px; height: 40px; }
			.brand { display: inline-flex; align-items: center; margin-right: auto; }
			footer .brand img { display: block; height: 40px; width: auto; }
			.cols .eyebrow { margin: var(--s3) 0 0; }
			nav { display: flex; align-items: center; gap: 2px; }
			nav a { color: var(--muted); text-decoration: none; padding: 6px var(--s3); border-radius: 999px; font-size: 0.95rem; transition: color 0.15s, background 0.15s; }
			nav a:hover { color: var(--text); background: var(--surface-2); }
			nav a[aria-current="page"] { color: #fff; background: var(--accent-strong); }
			/* the menu variant: the pill moves to the left and the links drop down from a hamburger */
			header.menu { justify-content: flex-start; }
			.burger { position: relative; }
			.burger summary { list-style: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--text); cursor: pointer; transition: background 0.15s; }
			.burger summary::-webkit-details-marker { display: none; }
			.burger summary:hover, .burger[open] summary { background: var(--surface-2); }
			.burger nav { position: absolute; top: calc(100% + 10px); left: -4px; min-width: 180px; flex-direction: column; align-items: stretch; gap: 2px; padding: 6px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); box-shadow: var(--shadow); }
			.burger nav a { padding: 8px var(--s3); }
			.skip { position: absolute; left: -999px; top: 8px; background: var(--accent-strong); color: #fff; padding: 8px 12px; border-radius: 8px; z-index: 100; }
			.skip:focus { left: 8px; }
			main.wide { max-width: none; padding-inline: var(--s5); }
			main { padding-block: var(--s6) 64px; }
			/* short pages still put the footer at the foot of the window */
			body { display: flex; flex-direction: column; min-height: 100vh; }
			main { flex: 1 0 auto; width: 100%; }
			/* the same forest band as the home page's "Start exploring", with its leaf and sun glows */
			footer { position: relative; isolation: isolate; overflow: hidden; padding: 88px 0 72px; background: linear-gradient(170deg, #2b4031, #1f3126 55%, #1a2a20); color: rgb(251 250 244 / 0.72); font-size: 0.9rem; }
			footer::before { content: ""; position: absolute; inset: -20% auto auto -8%; z-index: -1; width: 56%; height: 90%; background: radial-gradient(circle, rgb(100 116 79 / 0.45), transparent 70%); filter: blur(40px); }
			footer::after { content: ""; position: absolute; inset: auto -8% -20% auto; z-index: -1; width: 50%; height: 80%; background: radial-gradient(circle, rgb(241 179 98 / 0.18), transparent 70%); filter: blur(40px); }
			footer .eyebrow { color: var(--bg); }
			footer .eyebrow i { background: var(--sun); }
			footer :focus-visible { outline-color: var(--sun); }
			.cols { display: grid; gap: 48px; grid-template-columns: 2fr 1fr 1fr; }
			.cols p { margin: var(--s3) 0 0; max-width: 34ch; }
			footer h2 { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--bg); margin-bottom: var(--s3); }
			footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
			footer ul a { color: rgb(251 250 244 / 0.72); text-decoration: none; transition: color 0.15s; }
			footer ul a:hover { color: var(--sun); }
			@media (max-width: 720px) {
				nav a { padding: 6px var(--s2); font-size: 0.9rem; }
				.cols { grid-template-columns: 1fr 1fr; }
				.cols > :first-child { grid-column: 1 / -1; }
			}
			@media (max-width: 380px) {
				.bar { gap: 0; }
				nav a { padding: 6px 7px; font-size: 0.85rem; }
			}
		</style>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class:list={{ menu }}>
			<div class="bar">
				{menu && (
					<details class="burger">
						<summary aria-label="Menu">
							<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
						</summary>
						<nav aria-label="Main">
							{nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
						</nav>
					</details>
				)}
				<a class="brand" href="/" aria-label="Parava home">
					<img src="/brand/parava-emblem.svg" alt="" width="40" height="40" />
				</a>
				{!menu && (
					<nav aria-label="Main">
						{nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
					</nav>
				)}
			</div>
		</header>
		{menu && (
			<script is:inline>
				// close the menu on a click outside it or on Escape, like any other menu
				const menu = document.querySelector(".burger");
				document.addEventListener("click", (e) => {
					if (menu?.open && !menu.contains(e.target)) menu.open = false;
				});
				document.addEventListener("keydown", (e) => {
					if (e.key === "Escape" && menu?.open) {
						menu.open = false;
						menu.querySelector("summary")?.focus();
					}
				});
			</script>
		)}
		{bare ? <main id="main"><slot /></main> : <main id="main" class:list={["wrap", { wide }]}><slot /></main>}
		{!bare && (
			<footer>
				<div class="wrap">
					<div class="cols">
						<div>
							<a class="brand" href="/" aria-label="Parava home">
								<img src="/brand/parava-wordmark-light.svg" alt="" width="138" height="40" loading="lazy" />
							</a>
							<p class="eyebrow">Track<i></i>Explore<i></i>Protect</p>
							<p>Follow the world's migratory birds through the year, from the wetlands of India to the Arctic.</p>
						</div>
						<div>
							<h2>Explore</h2>
							<ul>{nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
						</div>
						<div>
							<h2>Data</h2>
							<ul>{sources.map(([href, label]) => <li><a href={href} rel="noopener">{label}</a></li>)}</ul>
						</div>
					</div>
				</div>
			</footer>
		)}
	</body>
</html>
